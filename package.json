    "drizzle-orm": "^0.45.4",
    "livekit-client": "^2.22.4",
    "livekit-server-sdk": "^2.19.1",
    "monaco-editor": "^0.57.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "pyodide": "^0.29.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
