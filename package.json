    "research": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/research.ts",
    "db:generate": "drizzle-kit generate",
    "postinstall": "node scripts/copy-vendor.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@electric-sql/pglite": "^0.5.8",
