# The voice agent worker. Copy to .env.local (or export these) and run `npm run dev`.

# LiveKit Cloud project (https://cloud.livekit.io) or a self-hosted server.
# Speech-to-text and text-to-speech run on LiveKit Inference, so no separate
# Deepgram or Cartesia keys are needed.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Where the Next.js app runs, and the shared secret it expects (same value as the app's).
APP_URL=http://localhost:3000
INTERVIEWER_AGENT_SECRET=

# Optional overrides.
LIVEKIT_AGENT_NAME=interviewer
STT_MODEL=deepgram/nova-3
TTS_MODEL=cartesia/sonic-3
