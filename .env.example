# Every setting the app reads. Copy to .env.local for local use, or enter them
# in Vercel's project settings for a hosted deploy (see DEPLOY.md). Everything
# is optional locally; values are left empty here on purpose. Never commit
# real values.

# --- Sign-in --------------------------------------------------------------
# "single": no accounts, one built-in user (the default locally).
# "accounts": email and password sign-up (the default on Vercel, so a hosted
# deploy is never left open). The settings until "Database" only matter with
# "accounts".
AUTH_MODE=

# Required with accounts in production: a random string of 32+ characters,
# e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The site's address, e.g. https://your-app.vercel.app (locally
# http://localhost:3000). On Vercel it falls back to the production domain.
BETTER_AUTH_URL=

# Invite-only sign-up: when set, creating an account needs this code. Strongly
# recommended for a hosted deploy, since every user can spend your API budget.
SIGNUP_INVITE_CODE=

# Optional "Continue with GitHub" (https://github.com/settings/developers,
# callback URL: <BETTER_AUTH_URL>/api/auth/callback/github). With an invite
# code set, GitHub only signs in existing accounts.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# With accounts, who can review research at /research and see usage at /stats
# (comma-separated emails, signed in with GitHub so the address is verified).
# Unset: anyone signed in during development, nobody in production.
ADMIN_EMAILS=

# --- Database -------------------------------------------------------------
# Empty: an embedded Postgres (PGlite) in ./.data. Required on Vercel: a hosted
# Postgres URL such as Neon's pooled connection string.
DATABASE_URL=

# --- Privacy --------------------------------------------------------------
# Days to keep interview recordings (transcripts, code timelines, reports, AI
# chats) before the daily job deletes them. Default 90.
RETENTION_DAYS=

# --- Scheduled jobs -------------------------------------------------------
# Protects /api/cron/research (weekly) and /api/cron/retention (daily); Vercel
# Cron sends it automatically. Unset, both jobs are off. Any long random
# string, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# --- Claude ---------------------------------------------------------------
# One key turns on Claude as the mock interviewer, the feedback grader, the
# AI-assisted and debugging round assistants, review variants and the research
# job. Without it, every feature uses its scripted or rule-based fallback.
# Get one at https://console.anthropic.com and set a monthly spend limit there.
ANTHROPIC_API_KEY=
# Model overrides (defaults in brackets).
# Interviewer [claude-sonnet-5-5]
INTERVIEWER_MODEL=
# Feedback grading [claude-opus-5-5]
FEEDBACK_MODEL=
# Research job [claude-opus-5-5]
RESEARCH_MODEL=
# Review variants [claude-opus-5-5]
VARIANT_MODEL=
# Debugging round assistant [claude-sonnet-5-5]
DEBUG_ASSISTANT_MODEL=

# --- Code execution -------------------------------------------------------
# Empty: code runs in the browser (JavaScript in a worker, Python via Pyodide).
# Set to a Judge0 instance to run on the server.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
JUDGE0_RAPIDAPI_KEY=
# Judge0 language ids (defaults: 71 = Python 3.8, 63 = Node 12).
JUDGE0_LANG_PYTHON=
JUDGE0_LANG_JAVASCRIPT=

# --- LiveKit voice --------------------------------------------------------
# Server speech-to-text and text-to-speech. Needs all four values and the
# agent worker in ./agent running elsewhere (it can't run on Vercel). Without
# them, mocks use the browser's speech recognition and voice.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared secret the agent worker uses to call the app; any long random string,
# e.g. `openssl rand -hex 32`. Use the same value in agent/.env.local.
INTERVIEWER_AGENT_SECRET=
# Agent name to dispatch [interviewer].
LIVEKIT_AGENT_NAME=
