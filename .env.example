# Copy to .env.local. Everything is optional for local development.

# Sign-in. Required in production: generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional "Continue with GitHub" (https://github.com/settings/developers,
# callback URL: <BETTER_AUTH_URL>/api/auth/callback/github).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database. Leave empty to use the embedded Postgres (PGlite) in ./.data.
# Set to a Postgres URL (Supabase, Neon, local) for anything shared.
DATABASE_URL=

# Code execution. Leave empty to run code in the browser (JavaScript in a
# worker, Python via Pyodide). Set to a Judge0 instance to run on the server.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
JUDGE0_RAPIDAPI_KEY=
# Judge0 language ids (defaults: 71 = Python 3.8, 63 = Node 12).
JUDGE0_LANG_PYTHON=
JUDGE0_LANG_JAVASCRIPT=

# Mock interviews (spec 4.3). Everything here is optional: with nothing set,
# mock interviews use the browser's speech recognition and voice, and a
# scripted practice interviewer.

# Claude as the interviewer. Get a key at https://console.anthropic.com.
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5-5.
INTERVIEWER_MODEL=

# LiveKit voice pipeline (server speech-to-text and text-to-speech). Needs all
# four values here and the agent worker in ./agent running (see README).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared secret the agent worker uses to call the app; any long random string,
# e.g. `openssl rand -hex 32`. Use the same value in agent/.env.local.
INTERVIEWER_AGENT_SECRET=
LIVEKIT_AGENT_NAME=
